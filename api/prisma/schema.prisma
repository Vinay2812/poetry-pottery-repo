generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

enum UserRole {
  ADMIN
  USER
}

model User {
  id      Int      @id @default(autoincrement())
  auth_id String   @unique
  email   String   @unique
  name    String?
  phone   String?
  image   String?
  role    UserRole @default(USER)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  addresses           Address[]
  cart_items          CartItem[]
  wishlist_items      WishlistItem[]
  orders              Order[]
  reviews             Review[]
  event_registrations EventRegistration[]
  workshop_bookings   WorkshopBooking[]
  newsletter          NewsletterSubscriber?

  @@map("users")
}

model Address {
  id         Int     @id @default(autoincrement())
  user_id    Int
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  is_default Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("addresses")
}

// ---------- Catalog ----------

model Category {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  name       String
  icon       String?
  image_url  String?
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  products Product[]

  @@map("categories")
}

model Collection {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String?
  image_url   String?
  starts_at   DateTime?
  ends_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  products Product[]

  @@map("collections")
}

model Product {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  description      String
  price            Int
  compare_at_price Int?
  material         String
  color_name       String?
  color_code       String?
  dimensions       String?
  care_notes       String[] @default([])
  image_urls       String[] @default([])
  stock            Int      @default(0)
  is_active        Boolean  @default(true)
  is_featured      Boolean  @default(false)
  is_customizable  Boolean  @default(false)
  collection_id    Int?

  // Denormalised so lists sort and render without aggregating.
  sales_count  Int   @default(0)
  rating_avg   Float @default(0)
  rating_count Int   @default(0)

  // Maintained by triggers and the embedding worker; see the initial migration.
  search_vector Unsupported("tsvector")?
  embedding     Unsupported("vector(384)")?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  collection     Collection?          @relation(fields: [collection_id], references: [id], onDelete: SetNull)
  categories     Category[]
  option_groups  ProductOptionGroup[]
  cart_items     CartItem[]
  wishlist_items WishlistItem[]
  order_items    OrderItem[]
  reviews        Review[]

  @@index([collection_id])
  @@index([is_active, created_at])
  @@index([price])
  @@index([sales_count])
  @@index([search_vector], type: Gin)
  @@map("products")
}

enum OptionGroupKind {
  CHOICE
  TEXT
}

model ProductOptionGroup {
  id             Int             @id @default(autoincrement())
  product_id     Int
  name           String
  kind           OptionGroupKind @default(CHOICE)
  is_required    Boolean         @default(true)
  // TEXT groups price the free-text entry itself and cap its length.
  price_modifier Int             @default(0)
  max_length     Int?
  sort_order     Int             @default(0)

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([product_id])
  @@map("product_option_groups")
}

model ProductOption {
  id             Int     @id @default(autoincrement())
  group_id       Int
  name           String
  price_modifier Int     @default(0)
  sort_order     Int     @default(0)
  is_active      Boolean @default(true)

  group ProductOptionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@map("product_options")
}

// ---------- Cart & wishlist ----------

model CartItem {
  id         Int    @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int    @default(1)
  /// [ProductSelections]
  selections Json?
  // Stable hash of selections so the same customised piece merges into one line.
  selection_key String @default("")

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id, selection_key])
  @@index([user_id])
  @@map("cart_items")
}

model WishlistItem {
  id         Int @id @default(autoincrement())
  user_id    Int
  product_id Int

  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@map("wishlist_items")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponKind {
  PERCENT
  FIXED
}

model Coupon {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  kind       CouponKind
  value      Int
  min_order  Int        @default(0)
  max_uses   Int?
  uses_count Int        @default(0)
  starts_at  DateTime?
  expires_at DateTime?
  is_active  Boolean    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  orders Order[]

  @@map("coupons")
}

model Order {
  id           String      @id @default(nanoid(12))
  user_id      Int
  status       OrderStatus @default(PENDING)
  subtotal     Int
  discount     Int         @default(0)
  shipping_fee Int
  total        Int
  coupon_id    Int?
  /// [ShippingAddress]
  shipping_address Json
  customer_note    String?
  admin_note       String?
  tracking_note    String?
  cancel_reason    String?

  confirmed_at DateTime?
  paid_at      DateTime?
  shipped_at   DateTime?
  delivered_at DateTime?
  cancelled_at DateTime?
  refunded_at  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user   User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coupon Coupon?     @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([user_id, created_at])
  @@index([status, created_at])
  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  order_id      String
  product_id    Int
  product_name  String
  product_image String?
  unit_price    Int
  quantity      Int
  line_total    Int
  /// [ProductSelections]
  selections    Json?

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

// ---------- Reviews ----------

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int?
  event_id   Int?
  rating     Int
  body       String?
  image_urls String[] @default([])
  is_hidden  Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  event   Event?   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@unique([event_id, user_id])
  @@index([product_id, created_at])
  @@index([event_id, created_at])
  @@map("reviews")
}

// ---------- Events ----------

enum EventType {
  POTTERY_WORKSHOP
  OPEN_MIC
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum RegistrationStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  CANCELLED
}

model Event {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  title           String
  description     String
  event_type      EventType   @default(POTTERY_WORKSHOP)
  status          EventStatus @default(DRAFT)
  level           EventLevel?
  starts_at       DateTime
  ends_at         DateTime
  location        String
  address         String
  price           Int
  total_seats     Int
  available_seats Int
  instructor      String?
  image_url       String
  gallery         String[]    @default([])
  includes        String[]    @default([])
  highlights      String[]    @default([])
  performers      String[]    @default([])

  rating_avg   Float @default(0)
  rating_count Int   @default(0)

  search_vector Unsupported("tsvector")?
  embedding     Unsupported("vector(384)")?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  registrations EventRegistration[]
  reviews       Review[]

  @@index([status, starts_at])
  @@index([event_type])
  @@index([search_vector], type: Gin)
  @@map("events")
}

model EventRegistration {
  id            String             @id @default(nanoid(12))
  event_id      Int
  user_id       Int
  seats         Int                @default(1)
  unit_price    Int
  discount      Int                @default(0)
  total         Int
  status        RegistrationStatus @default(PENDING)
  note          String?
  cancel_reason String?

  approved_at  DateTime?
  confirmed_at DateTime?
  rejected_at  DateTime?
  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([user_id])
  @@index([status])
  @@map("event_registrations")
}

// ---------- Daily workshops ----------

model WorkshopConfig {
  id                  Int     @id @default(autoincrement())
  slug                String  @unique
  name                String
  description         String?
  image_url           String?
  is_active           Boolean @default(true)
  timezone            String  @default("Asia/Kolkata")
  opening_minutes     Int     @default(780)
  closing_minutes     Int     @default(1140)
  slot_minutes        Int     @default(60)
  capacity_per_slot   Int     @default(6)
  booking_window_days Int     @default(60)
  slot_span_days      Int     @default(1)
  closed_weekdays     Int[]   @default([])

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  tiers     WorkshopPricingTier[]
  blackouts WorkshopBlackout[]
  bookings  WorkshopBooking[]

  @@map("workshop_configs")
}

model WorkshopPricingTier {
  id                Int @id @default(autoincrement())
  config_id         Int
  hours             Int
  price_per_person  Int
  pieces_per_person Int

  config WorkshopConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, hours])
  @@map("workshop_pricing_tiers")
}

model WorkshopBlackout {
  id        Int      @id @default(autoincrement())
  config_id Int
  starts_at DateTime
  ends_at   DateTime
  reason    String?

  created_at DateTime @default(now())

  config WorkshopConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@index([config_id, starts_at, ends_at])
  @@map("workshop_blackouts")
}

enum CancelledBy {
  USER
  ADMIN
  SYSTEM
}

model WorkshopBooking {
  id                String             @id @default(nanoid(12))
  config_id         Int
  user_id           Int
  starts_at         DateTime
  ends_at           DateTime
  hours             Int
  participants      Int
  price_per_person  Int
  pieces_per_person Int
  subtotal          Int
  discount          Int                @default(0)
  total             Int
  status            RegistrationStatus @default(PENDING)
  note              String?
  cancel_reason     String?
  cancelled_by      CancelledBy?

  approved_at  DateTime?
  confirmed_at DateTime?
  rejected_at  DateTime?
  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  config WorkshopConfig       @relation(fields: [config_id], references: [id], onDelete: Cascade)
  user   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  slots  WorkshopBookingSlot[]

  @@index([config_id, starts_at, ends_at])
  @@index([user_id])
  @@index([status])
  @@map("workshop_bookings")
}

// One chosen hour. A three-hour booking holds three of these, not always on the same day.
model WorkshopBookingSlot {
  id         Int      @id @default(autoincrement())
  booking_id String
  starts_at  DateTime
  ends_at    DateTime

  booking WorkshopBooking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@unique([booking_id, starts_at])
  @@index([starts_at])
  @@map("workshop_booking_slots")
}

// ---------- Marketing & content ----------

model NewsletterSubscriber {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  user_id         Int?      @unique
  token           String    @unique @default(nanoid(24))
  is_active       Boolean   @default(true)
  unsubscribed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  subject String?
  message String
  is_read Boolean @default(false)

  created_at DateTime @default(now())

  @@index([is_read, created_at])
  @@map("contact_messages")
}

model SiteSettings {
  id                  Int     @id @default(1)
  contact_phone       String  @default("")
  whatsapp_number     String  @default("")
  contact_email       String  @default("")
  address             String  @default("")
  opening_hours       String  @default("")
  instagram_url       String  @default("")
  facebook_url        String  @default("")
  youtube_url         String  @default("")
  shipping_flat_fee   Int     @default(150)
  free_shipping_above Int?
  announcement_text   String?
  announcement_href   String?
  hero_heading        String  @default("")
  hero_subheading     String  @default("")
  hero_image_url      String  @default("")
  hero_cta_text       String  @default("")
  hero_cta_href       String  @default("")

  updated_at DateTime @default(now()) @updatedAt

  @@map("site_settings")
}

model ContentPage {
  slug           String  @id
  title          String
  subtitle       String?
  hero_image_url String?
  /// [ContentSections]
  sections       Json
  is_published   Boolean @default(true)

  updated_at DateTime @default(now()) @updatedAt

  @@map("content_pages")
}

// Images an admin uploaded and the API verified against the spec table; entity writes only accept these keys.
model ConfirmedUpload {
  key        String   @id
  purpose    String
  width      Int
  height     Int
  bytes      Int
  created_at DateTime @default(now())

  @@map("confirmed_uploads")
}
