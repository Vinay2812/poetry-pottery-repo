NODE_ENV=development
PORT=6060
# Local dev uses the poetry-and-pottery-infra Postgres (5435); this repo's infra/ compose exposes 5433
DATABASE_URL=postgresql://postgres:change-me@localhost:5435/poetry-and-pottery
CORS_ORIGINS=http://localhost:3030
LOG_LEVEL=debug
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_SHORT_LIMIT=10
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_STRICT_LIMIT=5
THROTTLE_STRICT_TTL_MS=60000
SENTRY_DSN=
# Shared with frontend codegen; unlocks introspection in production
SCHEMA_SYNC_KEY=change-me
