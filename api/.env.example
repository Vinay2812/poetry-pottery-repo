NODE_ENV=development
PORT=6060
# Local dev uses this repo's infra/docker compose stack (Postgres 5433, Redis 6381, RabbitMQ 5672)
DATABASE_URL=postgresql://poetry:poetry@localhost:5433/poetry_pottery
REDIS_URL=redis://localhost:6381
RABBITMQ_URL=amqp://poetry:poetry@localhost:5672
# Set to false on API replicas that should only serve GraphQL and never consume queue jobs
QUEUE_CONSUMERS_ENABLED=true
CORS_ORIGINS=http://localhost:3030
FRONTEND_URL=http://localhost:3030
LOG_LEVEL=debug
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_SHORT_LIMIT=10
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_STRICT_LIMIT=5
THROTTLE_STRICT_TTL_MS=60000
SENTRY_DSN=
# Shared with frontend codegen; unlocks introspection in production
SCHEMA_SYNC_KEY=change-me
# Semantic search embeddings (downloaded once into EMBEDDINGS_CACHE_DIR)
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_CACHE_DIR=.cache/models
# Transactional email; leave SMTP_HOST empty to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Poetry & Pottery <no-reply@poetryandpottery.in>
BUSINESS_EMAIL=
# Cloudflare R2 for admin image uploads; leave empty to disable uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
