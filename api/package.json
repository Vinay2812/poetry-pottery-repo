{
  "name": "poetry-pottery-api",
  "version": "0.0.1",
  "description": "Poetry & Pottery GraphQL API (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,scripts,test,prisma/seed}/**/*.ts\"",
    "prettier": "prettier --check .",
    "prettier:format": "prettier --write .",
    "schema:emit": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/emit-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "ts-node -r tsconfig-paths/register --project tsconfig.json test/integration/run.ts",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "migration:create": "prisma migrate dev --create-only",
    "migration:apply": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node -r tsconfig-paths/register --project tsconfig.json prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "make-admin": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/make-admin.ts",
    "search:reindex": "QUEUE_CONSUMERS_ENABLED=false ts-node -r tsconfig-paths/register --project tsconfig.json scripts/reindex-search.ts",
    "tsc": "tsc --noEmit",
    "import:legacy": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/import-legacy.ts",
    "db:seed:demo": "ts-node -r tsconfig-paths/register --project tsconfig.json prisma/seed/demo.ts",
    "db:reset:legacy": "pnpm db:reset && pnpm import:legacy && pnpm search:reindex"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@clerk/express": "^2.1.58",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "^10.70.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "^5.1.16",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "prisma-json-types-generator": "^5.1.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
