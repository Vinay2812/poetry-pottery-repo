# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /app

# Install everything, generate + compile, then prune to production deps in place.
# Pruning (rather than a separate --prod install) keeps the Prisma client, which
# pnpm generates inside the @prisma/client package in the .pnpm store.
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
# prisma.config.ts resolves DATABASE_URL at generate time (no connection is made).
RUN DATABASE_URL='postgresql://dummy:dummy@postgres:5432/dummy' pnpm prisma:generate && pnpm exec nest build
RUN pnpm prune --prod

FROM node:24-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
USER node
EXPOSE 5050
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5050/health || exit 1
CMD ["node", "dist/main.js"]
