# syntax=docker/dockerfile:1

# Debian (glibc) rather than Alpine: onnxruntime-node, which the embeddings model runs on, ships glibc binaries.
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate
WORKDIR /app

# Install everything, generate and compile. This stage keeps the dev dependencies
# (Prisma CLI, ts-node) and is what the compose `migrate` service runs.
FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
# prisma.config.ts resolves DATABASE_URL at generate time (no connection is made).
RUN DATABASE_URL='postgresql://dummy:dummy@postgres:5432/dummy' pnpm prisma:generate && pnpm exec nest build

# Prune to production deps in place. Pruning (rather than a separate --prod install)
# keeps the generated Prisma client inside the @prisma/client package in the .pnpm store.
FROM build AS pruned
RUN pnpm prune --prod

FROM node:24-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=pruned --chown=node:node /app/node_modules ./node_modules
COPY --from=pruned --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
# The embeddings model is cached here at runtime; the node user must own it.
RUN mkdir -p /app/.cache/models && chown -R node:node /app/.cache
USER node
EXPOSE 6060
# node:slim ships neither wget nor curl; node's own fetch does the probe.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:6060/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "dist/main.js"]
