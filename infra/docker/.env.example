# Compose interpolation values — auto-loaded by `docker compose -f infra/docker/...`
# because this file sits next to the compose files. Copy to .env and adjust.
#
# API runtime env (Clerk keys, SCHEMA_SYNC_KEY, log level, throttles) is NOT here:
# the api service loads it from api/.env via env_file.

# --- Postgres (docker-compose.db.yml; also builds the API's DATABASE_URL) ----
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=boilerplate
POSTGRES_DB=boilerplate
# Host port mapping (5432 is taken by another local project).
POSTGRES_PORT=5433

# --- Redis (docker-compose.db.yml) -------------------------------------------
# Host port mapping (6379/6380 are taken by other local projects).
REDIS_PORT=6381
