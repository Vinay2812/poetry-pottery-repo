{
  "name": "poetry-pottery",
  "version": "0.0.1",
  "private": true,
  "description": "Poetry & Pottery — handcrafted pottery e-commerce and workshops. Root is the git hook host only; app code lives in frontend/ and api/, each with its own packages.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,mjs,css,md,json,gql,graphql}": "pnpm -C frontend exec prettier --write",
    "api/**/*.{ts,js,mjs,md,json}": "pnpm -C api exec prettier --write",
    "./*.{md,json,yml,yaml}": "prettier --write",
    ".vscode/*.json": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
