    { "id": "shipped-refunded", "from": "shipped", "to": "refunded", "variant": "security", "route": "drop", "channelY": 340, "fromSide": "bottom", "toSide": "top" },
    { "id": "delivered-refunded", "from": "delivered", "to": "refunded", "variant": "security", "route": "straight", "fromSide": "bottom", "toSide": "top" }
