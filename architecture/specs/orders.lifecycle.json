{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Order Lifecycle After Placement",
    "quality_profile": "showcase",
    "viewBox": [1000, 621],
    "views": [
      { "id": "happy-path", "label": "Happy path", "focus": ["pending", "confirmed", "paid", "shipped", "delivered"], "note": "Admin moves the order forward one step at a time or jumps Pending straight to Paid." },
      { "id": "cancel-paths", "label": "Cancellation paths", "focus": ["pending", "confirmed", "paid", "cancelled"], "note": "Customers self-cancel only from Pending or Confirmed; Paid+ is admin-only. Both release stock and coupon use once applyStatus commits." },
      { "id": "refund-paths", "label": "Refund paths", "focus": ["paid", "shipped", "delivered", "refunded"], "note": "Every terminal move is guarded by a status-predicated update (one writer wins) and mails the customer only after the transaction commits." }
    ]
  },
