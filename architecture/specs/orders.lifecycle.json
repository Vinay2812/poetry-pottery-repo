    { "id": "confirmed", "type": "active", "label": "Confirmed", "sublabel": "confirmed_at", "lane": "main", "col": 1, "step": "02", "tag": "held" },
    { "id": "paid", "type": "active", "label": "Paid", "sublabel": "paid_at", "lane": "main", "col": 2, "step": "03", "tag": "held" },
    { "id": "shipped", "type": "active", "label": "Shipped", "sublabel": "shipped_at", "lane": "main", "col": 3, "step": "04", "tag": "held" },
    { "id": "delivered", "type": "success", "label": "Delivered", "sublabel": "delivered_at", "lane": "main", "col": 4, "step": "05", "tag": "held" },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "cancelled_at", "lane": "terminal", "col": 0, "tag": "released", "height": 48 },
    { "id": "refunded", "type": "neutral", "label": "Refunded", "sublabel": "refunded_at", "lane": "terminal", "col": 2, "tag": "released", "height": 48 }
  ],
