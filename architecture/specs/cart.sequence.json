    {
      "dot": "emerald",
      "title": "How it works",
      "items": [
        "patch() applies useOptimistic instantly, no network wait",
        "run() awaits the real GraphQL mutation underneath",
        "refresh() refetch becomes the new baseline; retries quietly"
      ]
    },
    {
      "dot": "violet",
      "title": "Call trace",
      "items": [
        "use-optimistic-action.ts: execute → patch → run",
        "cart/types.ts: applyCartAction → canPredictShipping",
        "wishlist.service.ts: toggle → createMany/deleteMany"
      ]
    },
    {
      "dot": "rose",
      "title": "Edge cases",
      "items": [
        "canPredictShipping false → cart returned unmodified",
        "Rejected write: one failure toast, then a refresh() resync",
        "handleSaveForLater: toggle(id, name, true) then remove(item)"
      ]
    }
