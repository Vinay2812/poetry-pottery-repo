      {
        "id": "wishlist-toggle",
        "label": "Wishlist toggle",
        "focus": ["wishlist", "action", "wishlistApi", "db"],
        "note": "toggle() is idempotent, so save-for-later and a stale tab can never flip the wrong way."
      },
      {
        "id": "shared-hook",
        "label": "One hook, two features",
        "focus": ["action", "cartApi", "wishlistApi"],
        "note": "useOptimisticAction owns patch, run, refresh, and rollback for both features."
      }
